// ARVISX Web — schema principal (Fase 0-4 do plano)
// Ver plano em C:\Users\lcsin\.claude\plans\optimized-toasting-sloth.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["arvisx"]
}

// ---------- Enums ----------

enum Platform {
  META
  GOOGLE

  @@schema("arvisx")
}

enum CredentialStatus {
  PENDING
  CONNECTED
  AUTH_ERROR
  DISCONNECTED

  @@schema("arvisx")
}

enum CollectionState {
  OK
  AUTH_ERROR
  EMPTY
  API_ERROR

  @@schema("arvisx")
}

enum Verdict {
  BOM
  MEDIO
  RUIM

  @@schema("arvisx")
}

enum SystemRole {
  USER
  ADMIN

  @@schema("arvisx")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM

  @@schema("arvisx")
}

enum ProposalType {
  NEW_CAMPAIGN
  // Esteira completa da spec-gestor-trafego-ia.md (secao 1): 5 campanhas Meta
  // nascendo juntas (Frio/Morno/Quente/Remarketing/1%), com publico e exclusao
  // cruzada entre camadas - NEW_CAMPAIGN continua existindo separado pra campanha
  // avulsa (unica, sem esteira), nunca reaproveitado pra isto.
  NEW_FUNNEL
  PAUSE_AD
  ACTIVATE_AD
  ADJUST_BUDGET
  CREATE_AD_VARIATION
  CREATE_AB_TEST
  OTHER

  @@schema("arvisx")
}

/**
 * As 5 camadas da esteira, nesta ordem fixa (topo -> fundo -> escala). Remarketing
 * aqui e UMA camada so - as sub-janelas de 20/60/120 dias da secao 2 da spec (mensagem
 * diferente em cada etapa) ficam pra uma iteracao futura, nao fazem parte desta
 * primeira versao (ver comentario no executor sobre o motivo).
 */
enum FunnelLayerKey {
  FRIO
  MORNO
  QUENTE
  REMARKETING
  LOOKALIKE

  @@schema("arvisx")
}

enum ProposalStatus {
  NEEDS_MORE_DATA
  PENDING
  APPROVED
  REJECTED
  TEST
  ADJUST
  EXECUTED
  EXECUTION_FAILED

  @@schema("arvisx")
}

enum ExecutionAction {
  PAUSE_AD
  ACTIVATE_AD
  ADJUST_BUDGET
  CREATE_AD_VARIATION
  CREATE_AB_TEST
  NEW_CAMPAIGN
  NEW_FUNNEL

  @@schema("arvisx")
}

enum ExecutionStatus {
  SUCCESS
  FAILED

  @@schema("arvisx")
}

// ---------- Core models ----------

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  passwordHash       String
  image              String?
  // Papel de sistema: controla acesso ao painel /admin. Ver policies de RLS na migration
  // add_user_admin_rls - o Postgres reconfirma este campo direto do banco, nao confia so
  // na checagem da aplicacao.
  role               SystemRole @default(USER)
  // Forca a tela de troca de senha antes de liberar o resto do app - usado quando um
  // admin cria a conta ou reseta a senha de alguem (nunca definido pelo proprio usuario).
  mustChangePassword Boolean    @default(false)
  // Desativa o login sem apagar o historico (proposals/threads/etc criados por esse
  // usuario). Null = conta ativa.
  disabledAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  threads             ConversationThread[]
  decidedProposals    Proposal[]             @relation("ProposalDecidedBy")
  createdProposals    Proposal[]             @relation("ProposalCreatedBy")
  executions          ExecutionLog[]         @relation("ExecutedBy")
  providerConnections ProviderConnection[]
  creativeLibraryAssets CreativeLibraryAsset[] @relation("CreativeLibraryAssetCreatedBy")

  @@schema("arvisx")
}

/**
 * Um login OAuth (Meta ou Google Ads) de um usuario. Guardado uma unica vez por
 * pessoa+plataforma — conectar aqui descobre automaticamente todas as contas de anuncio
 * visiveis a esse login, e cada uma vira um AdCredential (nao ha passo manual de
 * atribuicao). E a raiz de posse de todo o dado do sistema: usuario -> conexao -> conta
 * de anuncio -> metricas/propostas/execucoes.
 */
model ProviderConnection {
  id                    String           @id @default(cuid())
  userId                String
  platform              Platform
  label                 String? // ex: nome da conta/Business Manager, preenchido no callback
  encryptedAccessToken  String // AES-256-GCM ciphertext (base64)
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  status                CredentialStatus @default(PENDING)
  lastCheckedAt         DateTime?
  lastError             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments AdCredential[]

  @@unique([userId, platform])
  @@schema("arvisx")
}

/**
 * Uma CONTA DE ANUNCIO (Meta ad account / Google Ads customer). E a entidade principal
 * do sistema: todo dado - metrica, proposta, execucao, ranking - pendura aqui.
 * Antes existia um conceito de "Marca" no meio (conta era atribuida manualmente a uma
 * marca, e a marca e que era dona do dado). Isso foi removido a pedido do Renan: era um
 * passo manual que nao agregava nada (na pratica sempre foi 1 conta = 1 marca, criada
 * automaticamente) e impedia o dado de aparecer no dashboard ate alguem atribuir.
 * Posse/autorizacao: conta -> providerConnection -> userId. Nao ha mais papeis
 * (VIEWER/MANAGER/OWNER) nem compartilhamento entre usuarios - quem conectou o login e
 * o dono de tudo que veio dele.
 * `(platform, externalAccountId)` continua unico globalmente: a mesma conta de anuncio
 * nunca aparece duas vezes no sistema.
 */
model AdCredential {
  id                   String           @id @default(cuid())
  providerConnectionId String
  platform             Platform
  externalAccountId    String // Meta ad account id / Google Ads customer id
  loginCustomerId      String? // Google Ads MCC login-customer-id, se aplicavel
  label                String? // nome da conta, vindo da descoberta - e o que a UI exibe
  status               CredentialStatus @default(PENDING)
  lastCheckedAt        DateTime?
  lastError            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  providerConnection      ProviderConnection       @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  metricSnapshots         AdMetricSnapshot[]
  campaignMetricSnapshots CampaignMetricSnapshot[]
  adCreatives             AdCreative[]
  rankingSnapshots        RankingSnapshot[]
  messages                Message[]
  proposals               Proposal[]
  executionLogs           ExecutionLog[]
  abTests                 AbTest[]
  schedulerResults        SchedulerAccountResult[]
  creativeLibraryAssets   CreativeLibraryAsset[]

  @@unique([platform, externalAccountId])
  @@schema("arvisx")
}

/**
 * Biblioteca de criativos ja publicados na conta - diferente de AdMetricSnapshot
 * (que e serie historica de propósito, uma linha por coleta), aqui e so o ESTADO
 * ATUAL de cada criativo: cada sincronizacao faz upsert por (credentialId,
 * platformAdId) em vez de acumular linha nova. Cobre anuncios sem gasto recente
 * tambem (listagem direta de objetos, nao um relatorio de Insights por data).
 */
model AdCreative {
  id                 String   @id @default(cuid())
  credentialId       String
  platform           Platform
  platformAdId       String
  platformCampaignId String?
  campaignName       String?
  adName             String?
  status             String?
  headline           String?
  bodyText           String?
  thumbnailUrl       String?
  callToAction       String?
  raw                Json?
  collectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, platformAdId])
  @@schema("arvisx")
}

model AdMetricSnapshot {
  id                 String          @id @default(cuid())
  credentialId       String
  platform           Platform
  platformCampaignId String?
  campaignName       String?
  platformAdId       String?
  adName             String?
  // Meta: id do AdSet (onde a verba mora). Google: id do AdGroup (necessario pra
  // pausar/ativar o anuncio - o resourceName exige adGroupId~adId).
  platformAdSetId    String?
  // Nome do AdSet (Meta) / AdGroup (Google) - nivel intermediario entre campanha e
  // anuncio. Null em coletas antigas (campo novo, so preenchido a partir desta
  // migration pra frente).
  adSetName          String?
  collectionState    CollectionState
  dateRangeStart     DateTime
  dateRangeEnd       DateTime
  spend              Decimal         @default(0) @db.Decimal(12, 2)
  impressions        Int             @default(0)
  clicks             Int             @default(0)
  ctr                Decimal         @default(0) @db.Decimal(7, 4) // percentual
  cpc                Decimal         @default(0) @db.Decimal(10, 2)
  conversions        Int             @default(0)
  cpl                Decimal?        @db.Decimal(10, 2)
  cpa                Decimal?        @db.Decimal(10, 2)
  // Campos estilo Gerenciador de Anuncios - nulos quando a plataforma nao fornece
  // (ex: alcance/frequencia nao existem por anuncio na maioria das campanhas do
  // Google Ads, entao ficam null la e nunca sao inventados).
  reach              Int?
  frequency          Decimal?        @db.Decimal(6, 2)
  cpm                Decimal?        @db.Decimal(10, 2)
  adStatus           String?
  raw                Json?
  errorMessage       String?
  collectedAt        DateTime        @default(now())

  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, platform, collectedAt])
  @@index([credentialId, platformAdId])
  @@schema("arvisx")
}

/**
 * Metrica no nivel de CAMPANHA - tabela separada de AdMetricSnapshot de proposito, nao
 * uma coluna "level" nela: existem 4 lugares que fazem
 * `distinct: ["credentialId", "platformAdId"]` (ranking/compute.ts, dashboard/page.tsx,
 * credentials/page.tsx, agent/tools/getMetrics.ts) e todos quebrariam silenciosamente
 * se linha de campanha entrasse na mesma tabela.
 * Duas coisas so existem aqui, nunca no nivel de anuncio:
 * 1. "reach" CORRETO - alcance e gente unica; somar o alcance dos anuncios de uma
 * campanha conta a mesma pessoa varias vezes. A Meta deduplica no servidor quando a
 * consulta e feita em level=campaign, entao esse e o unico numero de alcance de
 * campanha confiavel.
 * 2. "campaignStatus" - status da propria campanha (ativa/pausada). Antes disso o
 * sistema so conhecia status de ANUNCIO, e campanha pausada com anuncio ativo dentro
 * apareceria como ativa por engano.
 * Assim como AdMetricSnapshot, acumula historico (nunca apaga) - quem le pega so a
 * coleta mais recente por (credentialId, platformCampaignId).
 */
model CampaignMetricSnapshot {
  id                 String          @id @default(cuid())
  credentialId       String
  platform           Platform
  platformCampaignId String?
  campaignName       String?
  /**
   * Status da propria campanha na plataforma (ACTIVE/PAUSED/ENABLED...).
   */
  campaignStatus     String?
  /**
   * Objetivo da campanha (ex: OUTCOME_LEADS) - e o que decide qual acao conta como
   * "Resultado", pra bater com a coluna do Gerenciador de Anuncios.
   */
  objective          String?
  collectionState    CollectionState
  dateRangeStart     DateTime
  dateRangeEnd       DateTime
  spend              Decimal         @default(0) @db.Decimal(12, 2)
  impressions        Int             @default(0)
  clicks             Int             @default(0)
  ctr                Decimal         @default(0) @db.Decimal(7, 4) // percentual
  cpc                Decimal         @default(0) @db.Decimal(10, 2)
  /**
   * Quantidade de resultados, ja resolvida pelo objetivo (ver lib/ads/resultMetric.ts).
   */
  results            Int             @default(0)
  /**
   * Qual tipo de acao foi contado como resultado (ex: "lead", "link_click") - guardado
   * pra dar pra auditar de onde veio o numero em vez de so um total sem contexto.
   */
  resultType         String?
  /**
   * Custo por resultado.
   */
  cpr                Decimal?        @db.Decimal(10, 2)
  reach              Int?
  frequency          Decimal?        @db.Decimal(6, 2)
  cpm                Decimal?        @db.Decimal(10, 2)
  raw                Json?
  errorMessage       String?
  collectedAt        DateTime        @default(now())

  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, platform, collectedAt])
  @@index([credentialId, platformCampaignId])
  @@schema("arvisx")
}

model RankingSnapshot {
  id                     String   @id @default(cuid())
  credentialId           String
  computedAt             DateTime @default(now())
  verdict                Verdict
  bucketsJson            Json // { spend_no_conversion:[], low_ctr:[], high_cpl:[], scale_candidates:[], needs_new_creative:[] }
  recommendedActionsJson Json // ate 3: {reason, metrics, suggestedAction, risk, rollback}
  sourceRangeStart       DateTime
  sourceRangeEnd         DateTime

  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, computedAt])
  @@schema("arvisx")
}

model ConversationThread {
  id                      String    @id @default(cuid())
  userId                  String
  title                   String?
  // So uma thread ACTIVE por usuario por vez - garantido de verdade por um indice unico
  // PARCIAL na migration (Prisma nao expressa indice parcial no schema.prisma, so o
  // "@@index" comum abaixo pra performance de busca). "Nova conversa" desativa a atual e
  // cria outra - nunca apaga, so arquiva (isActive=false continua toda no banco).
  isActive                Boolean   @default(true)
  // Resumo cumulativo do que ja saiu da janela verbatim enviada a LLM (ver
  // lib/agent/contextSummary.ts) - o que evita que assunto de semanas atras suma de
  // vez do que a JAMILE consegue "lembrar" so porque a thread cresceu.
  contextSummary          String?   @db.Text
  // Ate qual Message (USER/ASSISTANT) o contextSummary ja cobre - tudo depois dessa
  // mensagem ainda nao foi dobrado no resumo.
  summarizedUpToMessageId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastMessageAt           DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  proposals Proposal[]

  @@index([userId])
  @@schema("arvisx")
}

model Message {
  id             String      @id @default(cuid())
  threadId       String
  // Conta de anuncio que essa mensagem/tool call especifica tratava - null pra mensagens
  // sem uma conta clara (ex: saudacao). Nao substitui a validacao de acesso feita por
  // chamada de tool (assertAccountAccess em lib/agent/tools/index.ts) - e so pra exibir
  // de qual conta o turno falava na UI.
  credentialId   String?
  role           MessageRole
  content        String      @db.Text
  toolName       String?
  toolCallId     String?
  toolArgsJson   Json?
  toolResultJson Json?
  tokensInput    Int?
  tokensOutput   Int?
  createdAt      DateTime    @default(now())

  thread     ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  credential AdCredential?      @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([credentialId, createdAt])
  @@schema("arvisx")
}

model Proposal {
  id                         String         @id @default(cuid())
  credentialId               String
  threadId                   String?
  createdByUserId            String? // null quando criado pelo scheduler/agente de forma autonoma
  type                       ProposalType
  status                     ProposalStatus @default(PENDING)
  title                      String
  reason                     String         @db.Text
  metricsJson                Json // metricas citadas para justificar a recomendacao
  suggestedAction            String         @db.Text
  risk                       String         @db.Text
  rollbackPlan               String         @db.Text
  platform                   Platform?
  platformCampaignId         String?
  platformAdId               String?
  // Meta: id do AdSet (onde a verba mora - necessario pra executar ADJUST_BUDGET).
  // Google: id do AdGroup (necessario pra executar PAUSE_AD/ACTIVATE_AD).
  platformAdSetId            String?
  payloadJson                Json // proposta estruturada completa (budget, creative brief, etc.)
  // So para NEW_CAMPAIGN: imagem do anuncio anexada por um humano na revisao (a JAMILE
  // nunca gera/promete imagem - so texto/segmentacao/orcamento via payloadJson.campaignPlan).
  // Caminho de IMAGEM - mutuamente exclusivo com os 4 campos de video abaixo (uma
  // proposta usa um ou outro, nunca os dois - ver rota creative-video-asset).
  creativeAssetData          Bytes?
  creativeAssetMimeType      String?
  // Caminho de VIDEO - dois blobs, porque um anuncio em video precisa de DOIS arquivos:
  // o video em si (creativeVideoData) e uma imagem de capa/thumbnail (creativeCoverImageData)
  // que o executor hospeda publicamente (lib/media/publicAssets.ts) antes de criar o
  // criativo - a Meta exige uma URL publica ali, nao aceita hash de imagem como o
  // caminho de imagem usa. Ver executor.ts (branch NEW_CAMPAIGN/META) e a rota
  // /api/proposals/[id]/creative-video-asset.
  creativeVideoData          Bytes?
  creativeVideoMimeType      String?
  creativeCoverImageData     Bytes?
  creativeCoverImageMimeType String?
  decidedByUserId            String?
  decidedAt                  DateTime?
  decisionNote               String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  credential   AdCredential          @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  thread       ConversationThread?   @relation(fields: [threadId], references: [id])
  createdBy    User?                 @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id])
  decidedBy    User?                 @relation("ProposalDecidedBy", fields: [decidedByUserId], references: [id])
  executions   ExecutionLog[]
  abTest       AbTest?
  // So preenchido quando type=NEW_FUNNEL - as 5 linhas (uma por FunnelLayerKey) com o
  // texto/criativo de cada camada. NEW_CAMPAIGN continua usando os campos creative* do
  // Proposal direto, sem nenhuma linha aqui.
  funnelLayers ProposalFunnelLayer[]

  @@index([credentialId, status])
  @@schema("arvisx")
}

/**
 * Uma camada da esteira (FRIO/MORNO/QUENTE/REMARKETING/LOOKALIKE) dentro de uma
 * proposta NEW_FUNNEL - motivo de ser tabela separada, nao mais um JSON dentro de
 * payloadJson: cada camada precisa do PROPRIO criativo (o Renan pediu 5 uploads
 * distintos, um gancho por camada - secao 3 da spec), e Bytes nao cabe bem dentro de
 * JSON. O padrao imagem-OU-video espelha exatamente os mesmos 6 campos que Proposal ja
 * tem pro caminho unico de NEW_CAMPAIGN.
 */
model ProposalFunnelLayer {
  id                    String         @id @default(cuid())
  proposalId            String
  layerKey              FunnelLayerKey
  campaignName          String
  // Fatia ja calculada (ver lib/ads/funnelBudget.ts) a partir do orcamento TOTAL da
  // proposta - o Renan pensa em "quanto por dia pro produto todo", nao camada por
  // camada.
  dailyBudgetMinorUnits Int
  headline              String
  primaryText           String
  description           String
  callToAction          String

  creativeAssetData          Bytes?
  creativeAssetMimeType      String?
  creativeVideoData          Bytes?
  creativeVideoMimeType      String?
  creativeCoverImageData     Bytes?
  creativeCoverImageMimeType String?

  // Preenchidos so depois de executar - cada camada e uma Campanha/AdSet/Ad Meta real e
  // independente das outras (nao existe 1 campanha "esteira", sao 5 campanhas normais
  // ligadas so pela audiencia de exclusao entre elas).
  platformCampaignId String?
  platformAdSetId    String?
  platformAdId       String?
  // Id do publico personalizado CRIADO pra esta camada (audiencia de quem entra nela) -
  // outras camadas referenciam este id no proprio targeting.excludedCustomAudienceIds
  // delas, o mecanismo real de "quem ja esta aqui nao ve a camada anterior de novo".
  customAudienceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, layerKey])
  @@schema("arvisx")
}

/**
 * Banco de criativos por produto/gancho (spec-gestor-trafego-ia.md secao 3) - so
 * CATALOGO por enquanto (decisao do Renan em 2026-08-04): registra o que ja existe pra
 * cada combinacao produto+gancho, pra JAMILE apontar lacunas ("falta um criativo Quente
 * pro gancho bisneto") - NAO se conecta ao upload de criativo de NEW_CAMPAIGN/NEW_FUNNEL
 * (reaproveitar um item daqui numa proposta nova fica pra uma iteracao futura, se
 * decidido). productName/hook sao texto livre de proposito, espelhando o mesmo
 * enquadramento aberto que o spec usa (nao ha model Product persistido no sistema).
 * funnelStage e OPCIONAL porque nem todo criativo catalogado precisa ja estar
 * classificado por temperatura - reaproveita FunnelLayerKey (mesmo enum de
 * ProposalFunnelLayer) em vez de criar um enum novo so com FRIO/MORNO/QUENTE.
 * Mesmo padrao imagem-OU-video de 6 campos ja usado em Proposal/ProposalFunnelLayer.
 */
model CreativeLibraryAsset {
  id           String          @id @default(cuid())
  credentialId String
  productName  String
  hook         String
  funnelStage  FunnelLayerKey?
  label        String
  notes        String?         @db.Text

  creativeAssetData          Bytes?
  creativeAssetMimeType      String?
  creativeVideoData          Bytes?
  creativeVideoMimeType      String?
  creativeCoverImageData     Bytes?
  creativeCoverImageMimeType String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation("CreativeLibraryAssetCreatedBy", fields: [createdByUserId], references: [id])

  @@index([credentialId, productName])
  @@schema("arvisx")
}

/**
 * Teste A/B real: dois anuncios de verdade rodando em paralelo (controle = original,
 * variante = copia com uma variavel mudada - so verba nesta versao). A comparacao usa
 * a coleta normal de metricas (AdMetricSnapshot), sem inventar estatistica.
 */
model AbTest {
  id             String    @id @default(cuid())
  proposalId     String    @unique
  credentialId   String
  platform       Platform
  controlAdId    String
  controlAdSetId String
  variantAdId    String
  variantAdSetId String
  testedVariable String // "BUDGET" - unica suportada nesta rodada
  controlValue   Decimal   @db.Decimal(10, 2)
  variantValue   Decimal   @db.Decimal(10, 2)
  startedAt      DateTime  @default(now())
  endsAt         DateTime
  status         String // RUNNING | COMPLETED
  winner         String? // CONTROL | VARIANT | INCONCLUSIVE
  resultSummary  Json?
  completedAt    DateTime?

  proposal   Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
  @@schema("arvisx")
}

model ExecutionLog {
  id               String          @id @default(cuid())
  proposalId       String // obrigatorio - garante "sempre vinculado a uma proposta"
  credentialId     String
  executedByUserId String?
  platform         Platform
  action           ExecutionAction
  requestJson      Json
  responseJson     Json?
  status           ExecutionStatus
  errorMessage     String?
  rollbackInfoJson Json?
  executedAt       DateTime        @default(now())

  proposal   Proposal     @relation(fields: [proposalId], references: [id])
  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  executedBy User?        @relation("ExecutedBy", fields: [executedByUserId], references: [id])

  @@index([credentialId, executedAt])
  @@schema("arvisx")
}

/**
 * Blob servido publicamente, sem autenticacao, por id (cuid - 128 bits de entropia,
 * impraticavel de adivinhar; nao ha rota de listagem, so leitura por id exato).
 * Existe por UMA razao concreta: a Meta baixa a thumbnail de um anuncio em video
 * (object_story_spec.video_data.image_url) fazendo uma requisicao HTTP normal a partir
 * dos servidores dela - nao aceita upload de bytes nem token de sessao nosso. image_hash
 * (o mecanismo que anuncio de IMAGEM usa, sem precisar de URL publica) nao e aceito
 * nesse campo segundo a doc oficial. Ver createMetaVideoAdCreative em metaWrite.ts.
 * So existe caminho de ESCRITA server-side (nenhuma rota POST publica) - o que evita
 * este endpoint virar hospedagem publica de arquivo arbitrario para qualquer um que
 * descubra a URL de upload. So o GET e publico, de proposito.
 * Sem limpeza automatica ainda - cresce sem limite. Aceitavel enquanto o volume for
 * baixo (uma thumbnail por campanha de video criada); se isso crescer, precisa de job
 * de retencao (ex: apagar registro nao referenciado por proposta nenhuma ha X dias).
 */
model PublicMediaAsset {
  id         String   @id @default(cuid())
  mimeType   String
  data       Bytes
  byteLength Int
  createdAt  DateTime @default(now())

  @@schema("arvisx")
}

// ---------- Observabilidade ----------

model SchedulerRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String // running | completed | failed
  errorMessage String?

  accountResults SchedulerAccountResult[]

  @@schema("arvisx")
}

model SchedulerAccountResult {
  id             String  @id @default(cuid())
  schedulerRunId String
  credentialId   String
  outcome        String // proposal_created | no_action | skipped_recent | error
  proposalId     String?
  errorMessage   String?

  run        SchedulerRun @relation(fields: [schedulerRunId], references: [id], onDelete: Cascade)
  credential AdCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@schema("arvisx")
}
